NODE_ENV=development
PORT=5000

# ─── MongoDB ───────────────────────────────────────────────────
# Get your URI from https://cloud.mongodb.com → Clusters → Connect
MONGO_URI=mongodb+srv://<YOUR_USER>:<YOUR_PASSWORD>@cluster0.xxxxx.mongodb.net/imocraft?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────
# Use a long, random string (at least 64 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MINIMUM_64_CHARACTERS
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ─── Frontend URL (for CORS) ───────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Payment Gateway ──────────────────────────────────────────
# Add when integrating a real payment gateway (e.g. PayHere, Stripe)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_MERCHANT_ID=

# ─── Email / SMTP ─────────────────────────────────────────────
# For order confirmation emails (add when integrating)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@imocraft.lk
EMAIL_FROM_NAME=IMO Craft
